{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "baseUrl": ".",
    "paths": {
      "@karmika/shared": [
        "../shared/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "../shared/src"
  ],
  "exclude": [
    "src/draw.ts",
    "src/fx.ts"
  ]
}
